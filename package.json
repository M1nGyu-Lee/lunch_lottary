{
  "name": "lunch-lottery",
  "version": "0.2.0",
  "description": "팀을 위한 제로페이 점심 복권",
  "author": "Lunch Lottery Contributors",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "desktop": "electron .",
    "test": "node --test tests/*.test.mjs",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "kr.team.lunchlottery",
    "productName": "점심복권",
    "asar": true,
    "electronDownload": { "cache": "work/electron-cache" },
    "files": ["app/**/*", "electron/**/*", "package.json"],
    "directories": { "output": "dist" },
    "win": { "icon": "build/icon.ico", "target": [{ "target": "portable", "arch": ["x64"] }], "artifactName": "LunchLottery-Windows-${version}.${ext}" },
    "mac": { "icon": "build/icon.png", "identity": "-", "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }], "artifactName": "LunchLottery-macOS-${arch}-${version}.${ext}", "category": "public.app-category.food-and-drink", "extendInfo": { "NSLocalNetworkUsageDescription": "같은 교육장 네트워크에서 점심복권 음식점과 추첨 이력을 공유합니다." } }
  }
}
